# ===================================================================
# Supply Chain Forecasting — environment template
# Copy to `.env` and fill values. NEVER commit the real `.env`.
# ===================================================================

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
TOPIC_LIVE_WEB_TRAFFIC=live_web_traffic
TOPIC_INVENTORY_UPDATES=inventory_updates
TOPIC_SYSTEM_ALERTS=system_alerts
TOPIC_PRICING_UPDATES=automated_pricing_updates

# ---- HDFS ----
HDFS_NAMENODE=hdfs://localhost:9000
HDFS_BRONZE=/data/bronze
HDFS_SILVER=/data/silver
HDFS_GOLD=/data/gold

# ---- Spark ----
SPARK_MASTER=spark://localhost:7077
SPARK_APP_NAME=supply-chain-forecasting
SPARK_EXECUTOR_MEMORY=2g
SPARK_DRIVER_MEMORY=2g

# ---- Redis (serving layer) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---- MLflow ----
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_FORECAST_MODEL=demand_forecast
MLFLOW_LSTM_MODEL=surge_classifier

# ---- Pricing engine (business tunables) ----
PRICE_ELASTICITY_COEFF=0.35
PRICE_MAX_UPLIFT_PCT=0.25
PRICE_MIN_MARGIN_PCT=0.10
SURGE_VELOCITY_THRESHOLD=2.0
STREAMING_WINDOW_SECONDS=60
# Structured Streaming state-store checkpoint for the per-SKU LSTM history buffer (issue #36).
STREAMING_CHECKPOINT_DIR=/tmp/scf-checkpoints/pricing_stream

# ---- Price presentation psychology (streaming/pricing/psychology.py) ----
PRICE_PSYCHOLOGY_ENABLED=true
PRICE_CHARM_ENDING=0.99          # 0.99/0.95 value framing; 0.00 for premium round-number signal
PRICE_MIN_DISPLAY_FLOOR_PCT=0.0  # protect quality signal; never present below base*(1+this)

# ---- OPTIONAL: Plaid Sandbox supplier-payment reconciliation (free; off by default) ----
PLAID_ENABLED=false              # keep false for zero-cost default
PLAID_ENV=sandbox                # sandbox ONLY (free) — never production in this project
PLAID_CLIENT_ID=
PLAID_SECRET=

# ---- n8n / automation ----
N8N_WEBHOOK_URL=http://localhost:5678/webhook/reorder
SUPPLIER_EMAIL=supplier@example.com
INVENTORY_REORDER_THRESHOLD=50

# ---- Observability ----
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOG_LEVEL=INFO
