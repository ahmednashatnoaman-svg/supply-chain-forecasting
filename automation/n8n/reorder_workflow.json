{
  "name": "Automated Reorder (simulated email, zero-cost default)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "reorder",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [150, 300],
      "webhookId": "reorder-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json[\"headers\"][\"x-webhook-secret\"]}}",
              "value2": "={{$env.WEBHOOK_SHARED_SECRET}}"
            }
          ]
        }
      },
      "name": "Verify Shared Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [350, 300],
      "notes": "Security audit follow-up: alert_bridge.py sends X-Webhook-Secret when settings.automation.n8n_webhook_secret is set (empty by default -- no-op, matching the zero-config demo). Set N8N_WEBHOOK_SECRET (Python side) and WEBHOOK_SHARED_SECRET (this n8n container's env) to the same value before ever pointing this at a real downstream action. Header-path expression verified against a live n8n instance; if n8n's webhook item shape changes in a future version, re-verify with a real POST + the 'Verify Shared Secret' node's pin-data view."
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "sku", "value": "={{$json[\"sku\"]}}" },
            { "name": "qty", "value": "={{$json[\"qty\"]}}" },
            { "name": "supplier_email", "value": "={{$json[\"supplier_email\"]}}" },
            { "name": "subject", "value": "={{$json[\"subject\"]}}" },
            { "name": "body", "value": "={{$json[\"body\"]}}" }
          ]
        },
        "options": {}
      },
      "name": "Shape Purchase Order",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [550, 220]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "SIMULATED_EMAIL_SENT — zero-cost default. Swap this NoOp node for an Email Send node + free SMTP (e.g. Gmail) if a real supplier email is desired; see docs/reference/cost-and-licensing.md."
            }
          ]
        },
        "options": {}
      },
      "name": "Simulated Email (NoOp Log)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [750, 220]
    },
    {
      "parameters": {
        "values": {
          "string": [{ "name": "status", "value": "REJECTED_bad_or_missing_webhook_secret" }]
        },
        "options": {}
      },
      "name": "Unauthorized (NoOp)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [550, 400]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Verify Shared Secret", "type": "main", "index": 0 }]]
    },
    "Verify Shared Secret": {
      "main": [
        [{ "node": "Shape Purchase Order", "type": "main", "index": 0 }],
        [{ "node": "Unauthorized (NoOp)", "type": "main", "index": 0 }]
      ]
    },
    "Shape Purchase Order": {
      "main": [[{ "node": "Simulated Email (NoOp Log)", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {},
  "id": "automated-reorder-workflow"
}
