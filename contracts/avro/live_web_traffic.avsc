{
  "type": "record",
  "name": "LiveWebTraffic",
  "namespace": "com.scf.contracts",
  "doc": "A single clickstream event replayed from Retailrocket by the ingestion layer.",
  "fields": [
    { "name": "event_time", "type": { "type": "long", "logicalType": "timestamp-millis" },
      "doc": "Event timestamp (epoch millis)." },
    { "name": "visitor_id", "type": "long", "doc": "Anonymous visitor id." },
    { "name": "event", "type": { "type": "enum", "name": "EventType",
        "symbols": ["view", "addtocart", "transaction"] },
      "doc": "Interaction type." },
    { "name": "item_id", "type": "long", "doc": "Product SKU. Partition key." },
    { "name": "price", "type": ["null", "double"], "default": null,
      "doc": "Observed price at event time, if known." }
  ]
}
