{
  "title": "Supply Chain — Platform Overview",
  "uid": "scf-overview",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["supply-chain", "platform"],
  "description": "Platform health: throughput, errors, and latency across all SCF layers (Nagy, plan Task 3).",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Records Processed — rate(5m)",
      "description": "Sum of scf_records_processed_total across all components.",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "sum(rate(scf_records_processed_total[5m])) by (component)",
          "legendFormat": "{{component}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errors — rate(5m)",
      "description": "Sum of scf_errors_total across all components. Should be 0.",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(scf_errors_total[5m])) by (component)",
          "legendFormat": "{{component}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Processing Latency — p95 (5m window)",
      "description": "95th-percentile latency in seconds across all SCF layers.",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(scf_latency_seconds_bucket[5m])) by (le, component))",
          "legendFormat": "p95 {{component}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Kafka — Consumer Lag",
      "description": "Always empty by design: Spark Structured Streaming manages Kafka offsets via its own checkpoint directory, never the standard consumer-group commit protocol kafka-exporter reads from -- there is no consumer group for it to report lag for. Topic throughput (this dashboard's 'Messages In/sec' panel) is the real signal for this architecture.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(kafka_consumergroup_lag) by (topic, consumergroup)",
          "legendFormat": "{{topic}} / {{consumergroup}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Redis — Commands / sec",
      "description": "rate() of redis_commands_processed_total (a counter) from redis-exporter -- this exporter version doesn't expose an instantaneous ops/sec gauge.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(redis_commands_processed_total[1m])",
          "legendFormat": "ops/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "gauge",
      "title": "Prometheus — Active Scrape Targets",
      "description": "Number of targets currently in 'up' state.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 2 },
            { "color": "green", "value": 4 }
          ]
        }
      },
      "targets": [
        {
          "expr": "count(up == 1)",
          "legendFormat": "targets up",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Kafka — Messages In / sec (by topic)",
      "description": "Rate of messages produced to each topic.",
      "gridPos": { "h": 5, "w": 18, "x": 6, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(kafka_topic_partition_current_offset[2m])) by (topic)",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Surge Pricing Events — rate(15m)",
      "description": "Sum of scf_surge_events_total: windows where the LSTM + velocity/baseline ratio triggered a surge price. Business-level signal, not plumbing health -- see streaming/pipeline/pricing_stream.py price_row().",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "sum(rate(scf_surge_events_total[15m])) by (component)",
          "legendFormat": "{{component}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Low-Stock Alerts — rate(15m)",
      "description": "Sum of scf_low_stock_alerts_total: SKUs that fell below the reorder threshold and were forwarded toward the n8n automated-reorder bridge -- see check_low_stock_alert().",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 }
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(scf_low_stock_alerts_total[15m])) by (component)",
          "legendFormat": "{{component}}",
          "refId": "A"
        }
      ]
    }
  ]
}
